      "cfg": 1.0,
      "model_sampling": null,
      "guidance": null,
      "negative_mode": "zeroout",
      "sample_chain": "ksampler",
      "declared_exception": false,
      "_container_edits": {
        "_why": "工作流容器 string_b_1 自带 'muted minimalist sketch style' 后缀，会污染受控提示词；置空。",
        "10": ""
      }
    }
  }
}
